# Primera prueba aislada. Generar .env.google.local con scripts/init-google-local.mjs.
# Usar siempre --env-file .env.google.local -p portal-google-local; no reemplazar .env.docker.
PORTAL_HTTP_PORT=8888
PORTAL_ENV_FILE=.env.google.local
NODE_ENV=development
AUTH_MODE=google
STORAGE_PROVIDER=google_drive
PUBLIC_BASE_URL=http://localhost:8888
GOOGLE_REDIRECT_URI=http://localhost:8888/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=GENERATE_SESSION_SECRET
TOKEN_ENCRYPTION_KEY=GENERATE_TOKEN_ENCRYPTION_KEY
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ALLOWED_SUBS=
# Persistent Docker volume, writable by 1000:1000; WAL/SHM live beside this file.
DATABASE_PATH=/var/lib/portal-data/portal.sqlite
LLM_PROVIDER=rules
MAX_CONCURRENT_JOBS=1
REMOTE_LOGIN=true
