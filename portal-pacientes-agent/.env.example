# Portal de Pacientes · Agente de importación
# Copiá este archivo como .env y completá lo necesario.

# --- Servidor ---
AUTH_MODE=pilot
STORAGE_PROVIDER=local
# Google requiere ambas modalidades, origen exacto y secretos privados (ver docs/google-drive-alpha.md).
PUBLIC_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ALLOWED_SUBS=
# En Ubuntu/Docker. En Windows Google local, usar una ruta absoluta privada propia.
DATABASE_PATH=/var/lib/portal-data/portal.sqlite
PORT=8787
HOST=127.0.0.1
# Orígenes del frontend que pueden llamar a la API (separados por coma).
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8765,http://localhost:8765
# Sirve el frontend (../portal-pacientes) en http://HOST:PORT/ para no depender de otro servidor.
SERVE_PORTAL=true

# --- Navegador ---
# false = ventana visible: el paciente inicia sesión en ella (comportamiento esperado del MVP).
HEADLESS=false
# Opcional. En Windows puede usarse Microsoft Edge instalado.
BROWSER_CHANNEL=
CHROMIUM_SANDBOX=true
# Docker lo activa en compose; local Windows mantiene la ventana nativa.
REMOTE_LOGIN=false
# Acceso privado al portal (obligatorio con NODE_ENV=production).
PORTAL_AUTH_USER=1234
PORTAL_AUTH_PASSWORD=1234

# --- Tiempos y límites ---
LOGIN_TIMEOUT_MINUTES=10
JOB_TTL_MINUTES=20
MAX_AGENT_STEPS=30
# Tiempo máximo por objetivo. Si no se define: 180000 (cloud) o 600000 (ollama).
# MAX_AGENT_DURATION_MS=180000
MAX_DOWNLOADS_PER_JOB=10
# Tiempo máximo para capturar cada PDF sin depender de decisiones del agente.
PDF_DOWNLOAD_TIMEOUT_MS=60000
# Tamaño máximo permitido por PDF (40 MiB). Se valida firma y tamaño; el MIME distinto genera warning si los bytes son PDF.
MAX_PDF_BYTES=41943040
# Centro DM: tamaño y timeout propios para estudios DICOM completos.
MAX_MEDICAL_ARCHIVE_BYTES=536870912
MEDICAL_ARCHIVE_DOWNLOAD_TIMEOUT_MS=120000
# Tiempo máximo para reconocer el viewer Pixeon (30 s por defecto).
PIXEON_VIEWER_READY_TIMEOUT_MS=30000
# Espera de la toolbar después de VIEWER_READY antes de usar los finders genéricos.
PIXEON_TOOLBAR_TIMEOUT_MS=30000
# Solo desarrollo: conservar visor y sesión 120 s tras un error recuperable; cancelar cierra antes.
PIXEON_DEBUG_KEEP_VIEWER_OPEN=false
PIXEON_DEBUG_KEEP_VIEWER_OPEN_MS=120000
# RDC: solo desarrollo; deja el modal/contexto abierto tras PDF_SOURCE_NOT_FOUND (máximo 120 s).
RDC_DEBUG_KEEP_MODAL_OPEN=false
RDC_DEBUG_KEEP_MODAL_OPEN_MS=120000
RDC_PDF_SOURCE_TIMEOUT_MS=30000
# Pixeon confirmado: origin exacto (el puerto 8090 es parte de la allowlist de Centro DM).
# Este origin también está fijado en la configuración del proveedor; acá se pueden declarar
# otros orígenes HTTPS exactos solo si se confirman explícitamente.
CENTRODM_ALLOWED_ORIGINS=https://curie.centrodm.com.ar:8090
# Solo contadores/tipo de página; nunca registra texto del portal ni datos clínicos.
PROVIDER_DEBUG_STRUCTURE=false
MAX_CONCURRENT_JOBS=1

# --- Modelo de IA ---
# anthropic | openai | ollama | rules   (rules = reglas deterministas sin IA para la validación inicial)
LLM_PROVIDER=rules

# Para LLM_PROVIDER=ollama (IA local y gratis; no se usa ninguna clave ni servicio externo):
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Tiempo máximo por decisión (un 8B por CPU tarda 2-10 s; la primera carga del modelo, hasta ~1 min).
OLLAMA_TIMEOUT_MS=120000
# Contexto del modelo. 8192 alcanza para la observación compacta; más contexto = más RAM y más lento.
OLLAMA_NUM_CTX=8192
# Cuánto tiempo queda el modelo cargado en memoria entre decisiones.
OLLAMA_KEEP_ALIVE=30m
# Solo se acepta Ollama en esta máquina. Otro host exige habilitarlo a propósito.
OLLAMA_ALLOW_REMOTE=false

# Para LLM_PROVIDER=anthropic:
# LLM_MODEL configurable si se habilita un proveedor externo.
ANTHROPIC_API_KEY=
# Para LLM_PROVIDER=openai (o cualquier API compatible con /chat/completions):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_MS=30000

# --- Modo de ejecución ---
# agent = navegador real + IA · fake = FakeProviderAgent (sin navegador ni laboratorio, para demos y E2E)
IMPORT_RUNNER=agent

# --- Depuración (NO activar con cuentas reales: puede capturar información médica) ---
PLAYWRIGHT_DEBUG_ARTIFACTS=false
# Solo desarrollo: imprime en consola el error interno completo (puede contener datos de la página).
AGENT_DEBUG_ERRORS=false
LOG_LEVEL=info
