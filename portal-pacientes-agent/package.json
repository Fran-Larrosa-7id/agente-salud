{
  "name": "portal-pacientes-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Agente de IA que trae estudios al Portal de Pacientes después de que el paciente inicia sesión manualmente en el portal del laboratorio.",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "start:fake": "tsx src/server/index.ts --fake",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/unit/*.test.ts test/e2e/*.test.ts",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "test:e2e": "node --import tsx --test --test-concurrency=1 test/e2e/*.test.ts",
    "test:ollama": "node --import tsx --test --test-concurrency=1 test/manual/ollama-e2e.test.ts"
  },
  "dependencies": {
    "express": "5.1.0",
    "playwright": "1.55.0"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
