# Docker: copiar a .env.docker o generar con scripts/init-docker.mjs.
AUTH_MODE=pilot
STORAGE_PROVIDER=local
# Para Google: AUTH_MODE=google y STORAGE_PROVIDER=google_drive. Ver portal-pacientes-agent/docs/google-drive-alpha.md.
PUBLIC_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ALLOWED_SUBS=
DATABASE_PATH=/var/lib/portal-data/portal.sqlite
LLM_PROVIDER=rules
# No reutilizar la contraseña de ninguna institución.
PORTAL_AUTH_USER=1234
PORTAL_AUTH_PASSWORD=1234
